<div class="modal fade" id="modalHabito" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold fs-4 text-dark">Novo hábito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form action="/habitos" method="POST">
                    <div class="mb-4">
                        <input type="text" name="name" class="form-control form-control-lg bg-light border-0" placeholder="Ex: Exercício, Leitura, Meditação" required>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted mb-3">Frequência (dias da semana)</label>
                        <div class="d-flex gap-2 justify-content-between">
                            <% const dias = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S']; %>
                            <% dias.forEach((dia, index) => { %>
                                <input type="checkbox" class="btn-check" name="days_of_week" id="dia<%= index %>" value="<%= index %>" autocomplete="off">
                                <label class="btn btn-outline-secondary rounded-circle fw-bold d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;" for="dia<%= index %>"><%= dia %></label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <button type="button" class="btn btn-light fw-bold text-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-brand fw-bold px-4">Salvar hábito</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>