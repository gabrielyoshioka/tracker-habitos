<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Habit Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light overflow-hidden">
    <div class="d-flex flex-column vh-100">
        
        <%- include('partials/topbar') %>

        <div class="d-flex flex-grow-1 overflow-hidden">
            <div class="flex-grow-1 overflow-auto p-5">
                <div class="row g-5">
                    <div class="col-md-6">
                        <h2 class="fw-bold mb-4 text-dark">Meu dia</h2>
                        
                        <% if (habitosHoje && habitosHoje.length > 0) { %>
                            <div class="d-flex flex-column gap-3 pe-4">
                                <% habitosHoje.forEach(habito => { %>
                                    <label class="d-flex align-items-center gap-3 p-3 border rounded-3 bg-white shadow-sm" style="cursor: pointer;">
                                        <input class="form-check-input flex-shrink-0 m-0 fs-5" type="checkbox" value="<%= habito.id %>">
                                        <span class="text-dark fs-5 fw-medium"><%= habito.name %></span>
                                    </label>
                                <% }) %>
                            </div>
                            
                            <button class="btn btn-outline-brand px-4 py-2 mt-4" data-bs-toggle="modal" data-bs-target="#modalHabito">
                                <i class="bi bi-plus"></i> Novo hábito
                            </button>
                            
                        <% } else { %>
                            <div class="pe-4">
                                <p class="text-secondary fs-5 mb-4">Nenhum hábito encontrado.<br>Crie um novo hábito para começar a registrar.</p>
                                <button class="btn btn-outline-brand px-4 py-2" data-bs-toggle="modal" data-bs-target="#modalHabito">
                                    <i class="bi bi-plus"></i> Novo hábito
                                </button>
                            </div>
                        <% } %>
                    </div>

                    <div class="col-md-6">
                        <h2 class="fw-bold mb-4 text-dark">Minha semana</h2>
                        <% if (rotinasSemana && rotinasSemana.length > 0) { %>
                        <% } else { %>
                            <div class="pe-4">
                                <p class="text-secondary fs-5 mb-4">Nenhuma rotina encontrada.<br>Crie uma nova rotina para começar a acompanhar.</p>
                                <button class="btn btn-outline-brand px-4 py-2" data-bs-toggle="modal" data-bs-target="#modalRotina">
                                    <i class="bi bi-plus"></i> Nova rotina
                                </button>
                            </div>
                        <% } %>
                    </div>

                </div>
            </div>

            <!-- Barra Lateral Injetada Aqui -->
            <%- include('partials/sidebar') %>

        </div>
    </div>

    <%- include('partials/modalHabito') %>
    <%- include('partials/modalRotina') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>